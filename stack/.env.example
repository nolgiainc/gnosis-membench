# Copy to .env and adjust.

# Where the gnosis repo checkout lives (docker build context)
GNOSIS_CONTEXT=../../gnosis

# ---------------------------------------------------------------------------
# NVIDIA inference gateway (recommended — tested 2026-07-17)
# Base URL works for both gnosis-internal LLM/embed calls and membench answer/judge.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=https://inference-api.nvidia.com/v1
OPENAI_API_KEY=${INFERENCE_API_KEY}

# Gnosis LLM — extraction, routing, chain-of-note, sufficiency check
GNOSIS_LLM=openai/openai/gpt-5.4-mini

# Embeddings — llama-embed-nemotron-8b gives 4096 dims, strong QA retrieval.
# Prefix "openai/" tells LiteLLM to use the OpenAI-compatible gateway (OPENAI_BASE_URL).
GNOSIS_EMBEDDING=openai/nvidia/llama-embed-nemotron-8b
GNOSIS_EMBEDDING_DIMENSIONS=4096

# Alternative embeddings (if you need 3072 dims for comparability with prior runs):
# GNOSIS_EMBEDDING=openai/gcp/google/gemini-embedding-2
# GNOSIS_EMBEDDING_DIMENSIONS=3072

# ---------------------------------------------------------------------------
# Service auth
# ---------------------------------------------------------------------------
GNOSIS_TOKEN=membench-token
NEO4J_PASSWORD=membench-neo4j

# ---------------------------------------------------------------------------
# membench answer + judge models
# These are consumed by the membench CLI, not by gnosis itself.
# Set in the shell before running `uv run membench run ...`
# ---------------------------------------------------------------------------
#
# Recommended (NVIDIA gateway, competitive — comparable to published LME_S results):
#   export OPENAI_BASE_URL=https://inference-api.nvidia.com/v1
#   export OPENAI_API_KEY=$INFERENCE_API_KEY
#   export MEMBENCH_ANSWER_MODEL=openai/openai/gpt-5.4
#   export MEMBENCH_JUDGE_MODEL=openai/openai/gpt-5.4
#
# Fast iteration (cheaper reader, same judge):
#   export MEMBENCH_ANSWER_MODEL=openai/openai/gpt-5.4-nano
#   export MEMBENCH_JUDGE_MODEL=openai/openai/gpt-5.4
#
# Claude reader (AWS Bedrock via NVIDIA gateway):
#   export MEMBENCH_ANSWER_MODEL=aws/anthropic/claude-haiku-4-5-v1
#   export MEMBENCH_JUDGE_MODEL=openai/openai/gpt-5.4    # keep judge consistent
#
# Claude reader + judge:
#   export MEMBENCH_ANSWER_MODEL=aws/anthropic/claude-haiku-4-5-v1
#   export MEMBENCH_JUDGE_MODEL=aws/anthropic/bedrock-claude-sonnet-5
#
# Gemini (fastest + cheapest):
#   export MEMBENCH_ANSWER_MODEL=gcp/google/gemini-2.5-flash-lite
#   export MEMBENCH_JUDGE_MODEL=openai/openai/gpt-5.4
#
# WARNING: changing MEMBENCH_JUDGE_MODEL shifts all scores vs published leaderboard.
#          Always log reader + judge model in RESULTS.md.

# ---------------------------------------------------------------------------
# Local ollama fallback (no API key needed)
# ---------------------------------------------------------------------------
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# GNOSIS_LLM=openai/llama3.2:latest
# GNOSIS_EMBEDDING=openai/nomic-embed-text
# GNOSIS_EMBEDDING_DIMENSIONS=768
