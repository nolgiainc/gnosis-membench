# Copy to .env and adjust. Everything has a working local-ollama default in compose.yaml.

# Where the gnosis repo checkout lives (docker build context)
GNOSIS_CONTEXT=../../gnosis

# OpenAI-compatible endpoint used BY GNOSIS for extraction + embeddings.
# Local ollama (default): pull models first:
#   ollama pull llama3.2:latest && ollama pull nomic-embed-text
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama
GNOSIS_LLM=openai/llama3.2:latest
GNOSIS_EMBEDDING=openai/nomic-embed-text
GNOSIS_EMBEDDING_DIMENSIONS=768

# In-cluster / prod: point at LiteLLM instead, e.g.
# OPENAI_BASE_URL=http://litellm.litellm.svc:4000/v1
# OPENAI_API_KEY=sk-...
# GNOSIS_LLM=openai/gemma4
# GNOSIS_EMBEDDING=local-qwen3-embedding-0.6b
# GNOSIS_EMBEDDING_DIMENSIONS=1024

# Service auth
GNOSIS_TOKEN=membench-token
NEO4J_PASSWORD=membench-neo4j

# ---------------------------------------------------------------------------
# membench answer + judge models (set in the shell / membench run env, not here)
# ---------------------------------------------------------------------------
# These are consumed by the membench CLI, not by gnosis itself.
# All use a single OPENAI_BASE_URL / OPENAI_API_KEY pair.
#
# Option A — OpenAI (default, comparable to published leaderboard entries)
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
#   MEMBENCH_ANSWER_MODEL=gpt-4o-mini        # reader: fast + cheap
#   MEMBENCH_JUDGE_MODEL=gpt-4o              # judge: keep stable for comparability
#
# Option B — codex-mini (fast iteration; not comparable to gpt-4o-mini results)
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
#   MEMBENCH_ANSWER_MODEL=codex-mini-latest
#   MEMBENCH_JUDGE_MODEL=gpt-4o
#
# Option C — Claude via Anthropic's OpenAI-compatible endpoint
#   OPENAI_BASE_URL=https://api.anthropic.com/v1
#   OPENAI_API_KEY=$ANTHROPIC_API_KEY
#   MEMBENCH_ANSWER_MODEL=claude-haiku-4-5-20251001   # very fast, low cost
#   MEMBENCH_JUDGE_MODEL=claude-sonnet-5
#
# Option D — LiteLLM proxy (mix OpenAI + Anthropic under one endpoint)
#   OPENAI_BASE_URL=http://localhost:4000/v1
#   OPENAI_API_KEY=sk-litellm
#   MEMBENCH_ANSWER_MODEL=claude-haiku-4-5-20251001
#   MEMBENCH_JUDGE_MODEL=gpt-4o
#
# WARNING: changing MEMBENCH_JUDGE_MODEL shifts all scores. Log it in RESULTS.md.
